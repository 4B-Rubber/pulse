# Embeds the newest docs/releases/<version>.md files (up to the version being
# built) into a target as RCDATA, so Settings > About can show release notes
# offline. An optional <version>.en.md is embedded as the English variant
# (resource id + 100); the UI falls back to <version>.md when it is missing.
# Generates generated/pulse_release_notes.{rc,h}.
function(pulse_embed_release_notes target)
    set(max_notes 8)
    set(base_id 29100)
    file(GLOB note_files CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/docs/releases/*.md")
    set(versions "")
    foreach(note IN LISTS note_files)
        # NAME, not NAME_WE: the version itself contains dots.
        get_filename_component(name "${note}" NAME)
        if(name MATCHES "^([0-9]+\\.[0-9]+\\.[0-9]+)\\.md$")
            set(version "${CMAKE_MATCH_1}")
            if(version VERSION_LESS_EQUAL PROJECT_VERSION)
                list(APPEND versions "${version}")
            endif()
        endif()
    endforeach()
    list(SORT versions COMPARE NATURAL ORDER DESCENDING)
    list(LENGTH versions count)
    if(count GREATER max_notes)
        list(SUBLIST versions 0 ${max_notes} versions)
        set(count ${max_notes})
    endif()

    set(rc "// Generated by cmake/release_notes.cmake. Do not edit.\nLANGUAGE 0, 0\n")
    set(header "#pragma once\n// Generated by cmake/release_notes.cmake. Do not edit.\n")
    string(APPEND header "#define PULSE_RELEASE_NOTE_RESOURCE_BASE ${base_id}\n")
    string(APPEND header "#define PULSE_RELEASE_NOTE_ENGLISH_OFFSET 100\n")
    string(APPEND header "#define PULSE_RELEASE_NOTE_COUNT ${count}\n")
    string(APPEND header "inline constexpr const wchar_t* kPulseReleaseNoteVersions[] = {")
    set(depends "")
    set(id ${base_id})
    foreach(version IN LISTS versions)
        set(path "${CMAKE_CURRENT_SOURCE_DIR}/docs/releases/${version}.md")
        string(APPEND rc "${id} RCDATA \"${path}\"\n")
        string(APPEND header "L\"${version}\", ")
        list(APPEND depends "${path}")
        set(english "${CMAKE_CURRENT_SOURCE_DIR}/docs/releases/${version}.en.md")
        if(EXISTS "${english}")
            math(EXPR english_id "${id} + 100")
            string(APPEND rc "${english_id} RCDATA \"${english}\"\n")
            list(APPEND depends "${english}")
        endif()
        math(EXPR id "${id} + 1")
    endforeach()
    string(APPEND header "nullptr};\n")

    set(out_dir "${CMAKE_BINARY_DIR}/generated")
    file(WRITE "${out_dir}/pulse_release_notes.h.tmp" "${header}")
    file(WRITE "${out_dir}/pulse_release_notes.rc.tmp" "${rc}")
    # COPYONLY only touches the outputs when the content changed.
    configure_file("${out_dir}/pulse_release_notes.h.tmp" "${out_dir}/pulse_release_notes.h" COPYONLY)
    configure_file("${out_dir}/pulse_release_notes.rc.tmp" "${out_dir}/pulse_release_notes.rc" COPYONLY)
    target_sources(${target} PRIVATE "${out_dir}/pulse_release_notes.rc")
    if(depends)
        set_property(SOURCE "${out_dir}/pulse_release_notes.rc" APPEND PROPERTY OBJECT_DEPENDS ${depends})
    endif()
endfunction()
